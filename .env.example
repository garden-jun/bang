# Vercel Storage에서 Upstash Redis 연결 시 자동 주입되는 값들.
# 로컬 개발은 Upstash 콘솔에서 복사해 .env.local 에 넣는다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 세션 토큰 서명 키. 설정하면 세션을 Redis에 저장하지 않아 커맨드 사용량이 크게 줄어든다.
# 임의의 긴 문자열: openssl rand -base64 32
# 바꾸면 기존 로그인이 모두 풀린다.
SESSION_SECRET=

# AI 봇이 쓸 OpenAI 키 (gpt-4o-mini). 없으면 봇은 LLM 없이 기본 수를 둔다.
OPENAI_API_KEY=

# 봇이 한 수를 두는 데 최소한 걸리는 시간(ms). 너무 짧으면 여러 수가 한꺼번에
# 지나가서 사람이 못 본다. 기본 1650 (클라이언트 연출 간격과 맞춰둔 값).
# 보통은 등록하지 않는다. 0은 기다림을 끄는 테스트용 값이다.
# BOT_MIN_MOVE_MS=1650
